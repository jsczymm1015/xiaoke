#!/usr/bin/env python3
"""Small standard-library-only bridge. No model calls, transcript storage or network."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import signal
import subprocess
import sys
import tempfile
import time
import uuid

VALID = re.compile(r'^[A-Za-z0-9_.-]{1,128}$')
STATUSES = ('started', 'progress', 'waiting', 'completed', 'failed', 'interrupted')
HOOKS = {'UserPromptSubmit': 'started', 'PreToolUse': 'progress',
         'PermissionRequest': 'waiting', 'Stop': 'completed', 'SessionEnd': 'interrupted'}


def data_directory():
    return Path(os.environ.get('XIAOKE_DATA_DIR', Path.home() / 'Library/Application Support/XiaoKeCompanion'))


def emit(provider, task, status, title='Agent task', phase=None, completed=None, total=None, ttl=45):
    if not VALID.fullmatch(provider) or not VALID.fullmatch(task):
        raise ValueError('provider/task must contain 1–128 ASCII letters, digits, _, - or .')
    if status not in STATUSES or not 5 <= ttl <= 86400:
        raise ValueError('invalid status or TTL (5–86400 seconds)')
    if len(title) > 120 or any(ord(c) < 32 or 127 <= ord(c) <= 159 for c in title):
        raise ValueError('title must be at most 120 characters without control characters')
    if (completed is None) != (total is None) or (total is not None and not 0 <= completed <= total <= 10000) or total == 0:
        raise ValueError('progress requires 0 <= completed <= total <= 10000, total > 0')
    if phase is not None and phase not in ('thinking', 'planning', 'executing', 'editing', 'searching', 'waiting', 'reviewing'):
        raise ValueError('unsupported phase')
    directory = data_directory() / 'agent-inbox'
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    if directory.is_symlink():
        raise ValueError('agent-inbox must not be a symbolic link')
    os.chmod(directory, 0o700)
    name = hashlib.sha256((provider + '\0' + task).encode()).hexdigest() + '.json'
    event = dict(version=1, eventID=str(uuid.uuid4()), provider=provider, taskID=task,
                 status=status, title=title, timestamp=time.time(), ttl=ttl,
                 phase=phase, completed=completed, total=total)
    encoded = json.dumps(event, ensure_ascii=False).encode()
    if len(encoded) > 4096:
        raise ValueError('event exceeds 4096 bytes')
    fd, temp = tempfile.mkstemp(prefix='.event-', dir=directory)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(encoded)
        os.replace(temp, directory / name)
    finally:
        if os.path.exists(temp): os.unlink(temp)
    # Keep normal long-term use bounded; live snapshots are never deleted.
    for file in directory.glob('*.json'):
        try:
            if not file.is_symlink() and time.time() - file.stat().st_mtime > 172800:
                file.unlink()
        except OSError:
            pass
    return event


def run_command(args):
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        raise ValueError('provide a command after --')
    task = args.task or str(uuid.uuid4())
    title = args.title or (args.provider + ' task')  # Never expose command arguments.
    emit(args.provider, task, 'started', title)
    child = None
    interrupted = False
    old_handlers = {}
    def forward(signum, frame):
        nonlocal interrupted
        interrupted = True
        if child is not None and child.poll() is None:
            child.send_signal(signum)
    try:
        for sig in (signal.SIGINT, signal.SIGTERM):
            old_handlers[sig] = signal.signal(sig, forward)
        child = subprocess.Popen(command)  # Inherit terminal, stdin/stdout/stderr; no shell.
        while True:
            try:
                code = child.wait(timeout=10)
                break
            except subprocess.TimeoutExpired:
                emit(args.provider, task, 'progress', title)
        emit(args.provider, task, 'interrupted' if interrupted or code < 0 else ('completed' if code == 0 else 'failed'), title)
        return 128 - code if code < 0 else code
    except OSError:
        emit(args.provider, task, 'failed', title)
        raise
    finally:
        for sig, handler in old_handlers.items(): signal.signal(sig, handler)


def claude_hook():
    # Parse transiently; retain only session identity and event name, never the prompt.
    raw = sys.stdin.buffer.read(1024 * 1024 + 1)
    if len(raw) > 1024 * 1024: return 0
    payload = json.loads(raw)
    if not isinstance(payload, dict): return 0
    kind = payload.get('hook_event_name')
    session = payload.get('session_id')
    if kind not in HOOKS or not isinstance(session, str) or not session: return 0
    task = hashlib.sha256(session.encode()).hexdigest()[:32]
    emit('claude-code', task, HOOKS[kind], 'Claude Code task', ttl=3600)
    return 0


def install_claude(args):
    settings = Path(args.settings).expanduser()
    original = settings.read_bytes() if settings.exists() else None
    config = json.loads(original) if original else {}
    if not isinstance(config, dict): raise ValueError('settings must be a JSON object')
    hooks = config.setdefault('hooks', {})
    if not isinstance(hooks, dict): raise ValueError('settings.hooks must be an object')
    command = shlex.quote(sys.executable) + ' ' + shlex.quote(str(Path(__file__).resolve())) + ' hook claude-code'
    for kind in HOOKS:
        entries = hooks.setdefault(kind, [])
        if not isinstance(entries, list): raise ValueError('hook entries must be arrays')
        if any(any(h.get('command') == command for h in e.get('hooks', []) if isinstance(h, dict)) for e in entries if isinstance(e, dict)):
            continue
        entry = {'hooks': [{'type': 'command', 'command': command, 'timeout': 5}]}
        if kind in ('PreToolUse', 'PermissionRequest'): entry['matcher'] = '*'
        entries.append(entry)
    settings.parent.mkdir(parents=True, exist_ok=True)
    if original is not None:
        backup = settings.with_name(settings.name + '.xiaoke-backup-' + uuid.uuid4().hex[:8])
        backup.write_bytes(original)
        os.chmod(backup, 0o600)
        print('Backup:', backup)
    fd, temp = tempfile.mkstemp(prefix='.xiaoke-', dir=settings.parent)
    try:
        with os.fdopen(fd, 'w') as stream: json.dump(config, stream, ensure_ascii=False, indent=2)
        os.replace(temp, settings)
    finally:
        if os.path.exists(temp): os.unlink(temp)
    print('Hooks installed:', settings, '\nRestart Claude Code to load the settings.')
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(description='小可 · local Agent companion bridge')
    sub = parser.add_subparsers(dest='action', required=True)
    event = sub.add_parser('event', help='publish a v1 task snapshot')
    event.add_argument('status', choices=STATUSES)
    event.add_argument('--provider', required=True)
    event.add_argument('--task', required=True)
    event.add_argument('--title', default='Agent task')
    event.add_argument('--phase')
    event.add_argument('--completed', type=int)
    event.add_argument('--total', type=int)
    event.add_argument('--ttl', type=int, default=45)
    run = sub.add_parser('run', help='wrap any foreground CLI and preserve its exit code')
    run.add_argument('--provider', default='cli')
    run.add_argument('--task')
    run.add_argument('--title')
    run.add_argument('command', nargs=argparse.REMAINDER)
    hook = sub.add_parser('hook', help='consume a provider hook on stdin')
    hook.add_argument('provider', choices=['claude-code'])
    install = sub.add_parser('install-claude', help='merge hooks without replacing existing settings')
    install.add_argument('--settings', default='.claude/settings.local.json')
    sub.add_parser('doctor', help='show local installation state')
    args = parser.parse_args(argv)
    try:
        if args.action == 'run': return run_command(args)
        if args.action == 'event':
            emit(args.provider, args.task, args.status, args.title, args.phase, args.completed, args.total, args.ttl)
        elif args.action == 'hook': return claude_hook()
        elif args.action == 'install-claude': return install_claude(args)
        elif args.action == 'doctor':
            print('Python:', sys.version.split()[0])
            print('Inbox:', data_directory() / 'agent-inbox')
            print('App:', '/Applications/小可桌宠.app', '(installed)' if Path('/Applications/小可桌宠.app').exists() else '(not found)')
            print('Enable Agent task reminders in 小可; no API key or network service needed.')
        return 0
    except (OSError, ValueError, TypeError) as error:
        # Hook failures must never block the agent or print input contents.
        if args.action == 'hook': return 0
        print('xiaoke:', error, file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
